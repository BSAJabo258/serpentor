# ---- Broadcast (documentary series) ----
# Local narration voice (Piper .onnx model + .json beside it), e.g. en_US-ryan-high
BSI_PIPER_VOICE=
# Or record narration yourself: drop own/scene_01.wav ... into an episode folder and re-render
# Folder of your own instrumentals, mixed under the narration with automatic ducking
BSI_MUSIC_DIR=
# YouTube: OAuth "Desktop app" client JSON from Google Cloud (YouTube Data API v3 enabled)
BSI_YOUTUBE_CLIENT_SECRETS=

# Copy to .env and fill in. All keys are free. Connectors without a key are skipped, not broken.
BSI_DB_PASSWORD=change-me
BSI_OLLAMA_MODEL=qwen2.5:7b-instruct

# US National Archives Catalog — email Catalog_API@nara.gov
NARA_API_KEY=
# USPTO PatentSearch (post-1976 patents) — https://search.patentsview.org/docs/
PATENTSVIEW_API_KEY=
# Smithsonian Open Access (incl. NMAAHC) — https://api.data.gov/signup/
DATA_GOV_API_KEY=
# Europeana — https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=
# Digital Public Library of America — https://pro.dp.la/developers/api-codex
DPLA_API_KEY=
# OpenAlex (optional, raises rate limits) — https://openalex.org
OPENALEX_API_KEY=
